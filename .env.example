# Preferred: deploy, then use the setup page to connect Devin with PKCE. The
# Upstash Marketplace integration injects KV_REST_API_URL and
# KV_REST_API_TOKEN automatically.
#
# Manual/local fallback — v3 service-user token with the machine scope and the
# outpost to serve.
DEVIN_OUTPOSTS_TOKEN=
DEVIN_OUTPOST_ID=
# Required to opt into the manual fallback in a Vercel deployment.
# ALLOW_MANUAL_DEVIN_CREDENTIALS=true
# DEVIN_API_URL=https://api.devin.ai
# Fixed production callback registered with Cognition.
# DEVIN_OAUTH_CALLBACK_URL=https://your-project.vercel.app/api/devin/callback

# Cloud deployment — Vercel Cron sends this value as a bearer token.
# Use a random string of at least 16 characters.
CRON_SECRET=
# Optional separate secret for connection setup and token encryption. When
# omitted, CRON_SECRET is used with domain-separated derived keys.
# DEVIN_CONNECTION_SECRET=

# Local mode only — Sandbox SDK access-token auth for running outside Vercel.
# See https://vercel.com/docs/sandbox/concepts/authentication#access-tokens
VERCEL_TOKEN=
VERCEL_TEAM_ID=team_...
VERCEL_PROJECT_ID=prj_...

# Orchestrator tuning (defaults shown).
# Cloud default: vercel-sandbox-<DEVIN_OUTPOST_ID>
# Local default: vercel-sandbox-<hostname>
# ACCEPTOR_ID=
# SANDBOX_RUNTIME=node24
# SANDBOX_VCPUS=2
# SANDBOX_TIMEOUT_MS=1200000
# POLL_INTERVAL_MS=3000
# MAX_CONCURRENT=5
