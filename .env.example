# Devin side — v3 service-user token with the machine scope, and the outpost
# to serve. Create the outpost with `devin worker outpost create <name>
# --platform linux` or in the Devin web app (Settings -> Environment -> Outposts).
DEVIN_OUTPOSTS_TOKEN=cog_...
DEVIN_OUTPOST_ID=outpost_env-...
# DEVIN_API_URL=https://api.devin.ai

# Vercel side — Sandbox SDK access-token auth (for running outside Vercel).
# See https://vercel.com/docs/sandbox/concepts/authentication#access-tokens
VERCEL_TOKEN=
VERCEL_TEAM_ID=team_...
VERCEL_PROJECT_ID=prj_...

# Orchestrator tuning (defaults shown).
# ACCEPTOR_ID=vercel-sandbox-<hostname>
# SANDBOX_RUNTIME=node24
# SANDBOX_VCPUS=4
# SANDBOX_TIMEOUT_MS=14400000
# POLL_INTERVAL_MS=5000
# MAX_CONCURRENT=5
