{
  "name": "devin-outpost-vercel",
  "version": "0.1.0",
  "private": true,
  "description": "Devin Outposts orchestrator that serves sessions in Vercel Sandbox microVMs",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "start:local": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "@vercel/sandbox": "2.8.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "workflow": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "ejs": "5.0.1",
    "filelist": "2.0.1",
    "jake": "11.9.5",
    "minimatch": "10.2.3",
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  }
}
